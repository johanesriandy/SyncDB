-- Example synced domain table #1.
-- Every synced table carries the two bookkeeping columns `_status` and `_changed`
-- in addition to its text primary key `id` and its domain columns.
CREATE TABLE posts (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL DEFAULT '',
    body TEXT NOT NULL DEFAULT '',
    is_pinned INTEGER NOT NULL DEFAULT 0,
    _status TEXT NOT NULL DEFAULT 'created',
    _changed TEXT NOT NULL DEFAULT ''
);
